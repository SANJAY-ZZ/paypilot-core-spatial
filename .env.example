# PayPilot Environment Configuration

# Database Connection (Supabase PostgreSQL or local SQLite)
# Example Supabase: postgresql://postgres.xxxx:yyyy@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Example Local: sqlite:///./paypilot.db
DATABASE_URL=sqlite:///./paypilot.db

# Supabase Credentials (Optional for local mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Reasoning Engine Configuration (Local Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=120.0

# Optional Alternative LLM Provider (OpenAI)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8.0

# API CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Razorpay Configuration Mode ('mock' or 'test')
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Application Environment ('development', 'testing', 'production')
ENVIRONMENT=development
APP_PORT=8000
